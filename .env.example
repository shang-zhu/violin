# Together AI — get yours at https://api.together.ai
TOGETHER_API_KEY=your_together_api_key_here


# Optional: Together AI dedicated endpoint for alternative TTS models
# Only needed if you provision a dedicated endpoint (e.g. Minimax Speech 2.6 Turbo)
# TOGETHER_TTS_BASE_URL=https://<your-deployment>.api.together.xyz/v1

# API server settings (optional)
# CORS_ORIGINS=https://yourdomain.com  # comma-separated allowed origins (default: *)
# JOBS_DIR=jobs          # where job files are stored (default: ./jobs)
# MAX_WORKERS=2          # max concurrent translation jobs (default: 2)
