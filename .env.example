# ── API keys ─────────────────────────────────────────────────
# Only fill in the keys for the providers you actually use — see
# config/default.yaml `models:` section. The default Together stack
# (Whisper + LLM + Cartesia TTS) needs only TOGETHER_API_KEY.

# Together AI — https://api.together.ai
TOGETHER_API_KEY=

# OpenAI — used when any stage uses `provider: openai` (may be left empty for
# gateways that ignore auth). https://platform.openai.com
OPENAI_API_KEY=

# Optional — OpenAI-compatible base URL for all OpenAI-provider stages
# (omit for api.openai.com). Example: https://litellm.internal/v1
# OPENAI_BASE_URL=

# ElevenLabs — needed when TTS uses `provider: elevenlabs`
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=


# ── Optional ─────────────────────────────────────────────────

# CORS allow-list for the web app (default: * — any origin)
# CORS_ORIGINS=https://yourdomain.com
